[Unit]
Description=Deploy Claude Window Starter release
After=network-online.target

[Service]
Type=oneshot
Environment=CLAUDE_STARTER_HOME=%h/.local/share/claude-window-starter
LoadCredential=telegram_token:%h/.local/share/claude-window-starter/shared/secrets/telegram_token
ExecStart=%h/.local/share/claude-window-starter/current/.venv/bin/python -m claude_starter --json update --apply
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/claude-window-starter %h/.config/systemd/user
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
