[Unit]
Description=Check Claude Window Starter private repository
After=network-online.target

[Service]
Type=oneshot
UMask=0077
Environment=CLAUDE_STARTER_HOME=%h/.local/share/claude-window-starter
ExecStart=%h/.local/share/claude-window-starter/current/.venv/bin/python -m claude_starter --json update --scheduled
TimeoutStartSec=10min
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
ReadWritePaths=%h/.local/share/claude-window-starter
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
