[Unit]
Description=Rollback Claude Window Starter to previous healthy release

[Service]
Type=oneshot
UMask=0077
Environment=CLAUDE_STARTER_HOME=%h/.local/share/claude-window-starter
ExecStart=%h/.local/share/claude-window-starter/current/.venv/bin/python -m claude_starter --json rollback --yes
TimeoutStartSec=10min
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
ReadWritePaths=%h/.local/share/claude-window-starter
